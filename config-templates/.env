# Hermes Agent — Environment variables template.
# Copy this to .env and fill in your keys.
# NEVER commit .env with real keys to git!

# === OpenCode Proxy (port 9224) ===
# No API key needed — OpenCode Zen free tier uses empty key.
# OPENCODE_API_KEY=

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
# Your chat ID (find via @userinfobot):
TELEGRAM_ALLOWED_CHAT=5366990698

# === Search (SearXNG is local, no keys needed) ===
SEARXNG_URL=http://localhost:8888

# === STT (Voice recognition) ===
# faster-whisper is local and free. No key needed.
# stt.language is set to "" in config.yaml = auto-detect (ru+en).

# === Fallback providers (optional) ===
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# === Ollama (local LLM for vision fallback) ===
# Ollama runs locally, no key needed.
# Default model: qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# === Vision Fallback (port 9225) ===
# No key needed — uses local proxy (:9224) + Ollama.

# === Sudo password for SSH operations (if using remote Bazzite) ===
# SUDO_PASSWORD=
